DATABASE_URL="file:./dev.db"

# Certificado Digital A1 (.pfx original — coloque na pasta certs/, nunca commitar)
CERT_PFX_PATH="./certs/certificado.pfx"
CERT_PFX_PASSWORD="senha-do-certificado"

# Opcional: certificado especifico por CNPJ ou por raiz.
# O app tambem tenta detectar automaticamente .pfx em certs/ quando a senha aparece no nome
# do arquivo como "Senha_..." ou "SENHA ...".
# CERT_PFX_PATH_50767035000129="./certs/facil-matriz.pfx"
# CERT_PFX_PASSWORD_50767035000129="senha"
# CERT_PFX_PATH_RAIZ_50767035="./certs/facil-matriz.pfx"
# CERT_PFX_PASSWORD_RAIZ_50767035="senha"

# Local Storage
DOWNLOAD_PATH="./downloads"

# Rotina server-side de NF (worker/cron)
CRON_SYNC_SECRET="troque-por-um-segredo-forte"
CRON_SYNC_URL="http://127.0.0.1:3100/api/internal/sync-nf"
# Anexos das notas (PDF/foto/planilha) — ficam no disco, fora do banco
ANEXOS_PATH="./anexos"

# Login local
AUTH_SECRET="troque-por-uma-frase-grande-aleatoria"

# SITRAM SEFAZ-CE (opcional; producao ja e o padrao)
SITRAM_API_URL="https://api.sefaz.ce.gov.br/service-transportadora-sitram"
SITRAM_PORTAL_API_URL="https://portal-sitram.sefaz.ce.gov.br"
