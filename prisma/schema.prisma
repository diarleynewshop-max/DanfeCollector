generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cnpj {
  id           Int       @id @default(autoincrement())
  cnpj         String    @unique
  razaoSocial  String?
  uf           String    @default("CE")
  ultimoNSU    String    @default("0")
  maxNSU       String    @default("0")
  ativo        Boolean   @default(true)
  situacao     String    @default("Nunca sincronizado")
  ultimaBusca  DateTime?
  // SEFAZ cStat 656 (consumo indevido): bloqueia novas consultas até este horário
  bloqueadoAte DateTime?
  ultimoNsuCte    String    @default("0")
  maxNsuCte       String    @default("0")
  situacaoCte     String    @default("Nunca sincronizado")
  ultimaBuscaCte  DateTime?
  bloqueadoAteCte DateTime?
  // Certificado digital vinculado (lido do repositório do Windows)
  certSerial     String?
  certThumbprint String?
  certVencimento DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  notas        NotaFiscal[]
  ctes         ConhecimentoTransporte[]
  usuarios     UsuarioCnpj[]
  spedsImportados SpedFiscalImportacao[]
}

model SyncWorkerStatus {
  id                Int      @id @default(1)
  status            String   @default("AGUARDANDO")
  iniciadoEm        DateTime?
  ultimoFimEm       DateTime?
  ultimoSucessoEm   DateTime?
  ultimoErroEm      DateTime?
  ultimaMensagem    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Usuario {
  id               Int           @id @default(autoincrement())
  login            String        @unique
  nome             String
  senhaHash        String
  perfil           String        @default("operador")
  ativo            Boolean       @default(true)
  acessoTodosCnpjs Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  cnpjs            UsuarioCnpj[]
  apiKeys          ApiKey[]
}

model UsuarioCnpj {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  cnpjId    Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cnpj      Cnpj     @relation(fields: [cnpjId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, cnpjId])
  @@index([cnpjId])
}

model NotaFiscal {
  id            Int      @id @default(autoincrement())
  chave         String   @unique
  nsu           String?
  numero        String?
  serie         String?
  emitidaEm     DateTime
  tipoOperacao  String?  // "Entrada" ou "Saída" (tpNF)
  naturezaOp    String?  // natureza da operação (natOp)

  // Emitente
  emitenteNome  String?
  emitenteCnpj  String?
  emitenteIe    String?
  emitenteUf    String?

  // Destinatário (só disponível em notas COMPLETA)
  destNome      String?
  destCnpj      String?

  // Valores (breakdown disponível em notas COMPLETA)
  valorTotal    Float?
  valorProdutos Float?
  valorFrete    Float?
  valorDesconto Float?
  valorIcms     Float?
  modalidadeFrete         String?
  transportadoraNome      String?
  transportadoraCnpj      String?
  transportadoraIe        String?
  transportadoraUf        String?
  transportadoraMunicipio String?

  // Quantidade de itens (det) — só disponível em notas COMPLETA
  qtdItens      Int?
  // Etiqueta livre definida pelo usuário, para organização e filtro
  etiqueta      String?
  conferenciaTipo          String?
  conferenciaStatus        String?
  conferenciaObservacao    String?
  conferenciaFonte         String?
  conferenciaAtualizadaEm  DateTime?
  conferenciaDivergencia   Boolean  @default(false)

  // RESUMO (resNFe — aguardando manifestação) ou COMPLETA (procNFe — XML integral)
  status        String   @default("RESUMO")
  // AUTORIZADA (padrão) | CANCELADA (evento 110111) | DENEGADA (cStat 110 na autorização)
  situacaoSefaz String   @default("AUTORIZADA")
  // Dados vindos do SITRAM/SEFAZ-CE (consulta por MDF-e)
  sitramConsultadaEm   DateTime?
  sitramChaveManifesto String?
  sitramAcaoFiscal     String?
  sitramSelada         Boolean?
  sitramSituacao       String?
  sitramDaeStatus      String?
  sitramDaeResumo      String?
  sitramDaeUrl         String?
  sitramDetalhe        String?
  recebimentoStatus                  String?
  recebimentoKanbanStatus            String?
  recebimentoStatusOperacional       String?
  recebimentoStatusOperacionalCodigo String?
  recebimentoAtualizadoEm            DateTime?
  recebimentoAtualizadoPor           String?
  recebimentoConsultadoEm            DateTime?
  recebimentoErro                    String?
  // Data da Ciência da Operação (evento 210210) já registrada para esta nota.
  // Quando preenchida, NÃO se deve manifestar de novo (SEFAZ só aceita 1x).
  manifestadaEm DateTime?
  xmlPath       String?
  pdfPath       String?
  // Chaves privadas no Supabase Storage; os caminhos legados acima ficam para rollback.
  xmlStorageKey String?
  pdfStorageKey String?
  // Pagamento do DAE registrado manualmente (via importação da relação de pagamento SITRAM).
  // Quando preenchido, o DAE é tratado como PAGO independente do status do SITRAM.
  pagamentoManualEm    DateTime?
  pagamentoManualRef   String?   // referência do lote/relatório importado
  pagamentoManualValor Float?     // valor do lançamento pago (informado no relatório)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cnpjId        Int
  cnpj          Cnpj     @relation(fields: [cnpjId], references: [id])
  anexos        Anexo[]

  // Índices para as colunas usadas em filtro/ordenação no painel e relatórios.
  // A FK cnpjId não é indexada automaticamente no Postgres.
  @@index([cnpjId, emitidaEm(sort: Desc)])
  @@index([cnpjId, status, manifestadaEm])
  @@index([cnpjId, sitramDaeStatus])
  @@index([cnpjId, situacaoSefaz])
  @@index([cnpjId, recebimentoStatus])
  @@index([cnpjId, conferenciaTipo])
  @@index([cnpjId, conferenciaStatus])
  @@index([cnpjId, conferenciaDivergencia])
}

model ConferenciaNewshopPendente {
  id           Int       @id @default(autoincrement())
  chave        String    @unique
  numero       String?
  emitidaEm    DateTime?
  emitenteCnpj String?
  emitenteNome String?
  serie        String?
  uf           String?
  valorTotal   Float?
  valorIcms    Float?
  situacaoNfe  String?
  tipo         String?
  status       String?
  observacao   String?
  fonte        String?
  motivo       String?
  importadaEm  DateTime  @default(now())

  @@index([importadaEm])
  @@index([status])
  @@index([tipo])
}

model ConhecimentoTransporte {
  id                  Int      @id @default(autoincrement())
  chave               String   @unique
  nsu                 String?
  numero              String?
  serie               String?
  emitidaEm           DateTime
  naturezaOp          String?
  cfop                String?
  status              String   @default("RESUMO")
  situacaoSefaz       String   @default("AUTORIZADO")
  emitenteNome        String?
  emitenteCnpj        String?
  emitenteIe          String?
  emitenteUf          String?
  tomadorNome         String?
  tomadorCnpj         String?
  remetenteNome       String?
  remetenteCnpj       String?
  destinatarioNome    String?
  destinatarioCnpj    String?
  valorTotal          Float?
  valorPrestacao      Float?
  valorCarga          Float?
  nfeChavePrincipal   String?
  xmlPath             String?
  xmlStorageKey       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cnpjId              Int
  cnpj                Cnpj     @relation(fields: [cnpjId], references: [id])
  notasVinculadas     ConhecimentoTransporteNfe[]

  @@index([cnpjId, emitidaEm(sort: Desc)])
  @@index([cnpjId, nfeChavePrincipal])
}

model ConhecimentoTransporteNfe {
  id       Int      @id @default(autoincrement())
  cteId    Int
  chaveNfe String
  cte      ConhecimentoTransporte @relation(fields: [cteId], references: [id], onDelete: Cascade)

  @@unique([cteId, chaveNfe])
  @@index([chaveNfe])
}

model DaeCompartilhado {
  id                   Int      @id @default(autoincrement())
  chave                String   @unique
  titulo               String
  identificadorExterno String?
  codigo               String?
  descricao            String?
  vencimento           String?
  valor                Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  anexos               Anexo[]
}

// Anexos por nota (PDF do DAE, foto de comprovante, planilha, etc.)
// O arquivo em si fica no disco (ANEXOS_PATH); aqui guardamos só os metadados.
model Anexo {
  id          Int        @id @default(autoincrement())
  nome        String     // nome/descrição dado pelo usuário
  arquivoNome String     // nome original do arquivo enviado
  mime        String     // content-type
  tamanho     Int        // bytes
  caminho     String     // caminho relativo dentro de ANEXOS_PATH
  // Chave privada no bucket danfe-anexos; caminho continua como fallback legado.
  storageKey  String?
  criadoPor   String?    // login de quem enviou
  createdAt   DateTime   @default(now())
  notaId      Int?
  nota        NotaFiscal?       @relation(fields: [notaId], references: [id], onDelete: Cascade)
  daeCompartilhadoId Int?
  daeCompartilhado   DaeCompartilhado? @relation(fields: [daeCompartilhadoId], references: [id], onDelete: Cascade)

  @@index([notaId])
  @@index([daeCompartilhadoId])
}

model ApiKey {
  id              Int       @id @default(autoincrement())
  nome            String
  prefixo         String    @unique
  tokenHash       String    @unique
  ativo           Boolean   @default(true)
  ultimoUsoEm     DateTime?
  criadaPorId     Int?
  criadaPorLogin  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  criadaPor       Usuario?  @relation(fields: [criadaPorId], references: [id], onDelete: SetNull)

  @@index([ativo])
}

// ─── SPED Fiscal (EFD ICMS/IPI) — Confronto ────────────────────────────

model SpedFiscalImportacao {
  id                   Int       @id @default(autoincrement())
  cnpjId               Int
  cnpj                 Cnpj      @relation(fields: [cnpjId], references: [id])
  periodo              String    // "2026-01" (YYYY-MM)
  dtInicio             DateTime
  dtFim                DateTime
  finalidade           String    // "ORIGINAL" | "RETIFICADORA"
  versaoLayout         String
  arquivoNome          String
  storageKey           String?
  status               String    @default("IMPORTADO") // IMPORTADO | PROCESSANDO | CONFRONTADO | ERRO
  totalRegistros       Int?
  totalC100            Int?
  totalC170            Int?
  totalParticipantes   Int?
  totalProdutos        Int?
  resumoDivergencias   String?   // JSON: { total, porTipo: { cadastro: N, cfop: N, ... }, porSeveridade: { ... } }
  erroMensagem         String?
  importadoEm          DateTime  @default(now())
  confrontadoEm        DateTime?
  updatedAt            DateTime  @updatedAt

  divergencias         SpedDivergencia[]

  @@unique([cnpjId, periodo, finalidade])
  @@index([cnpjId, periodo])
  @@index([status])
}

model SpedDivergencia {
  id                Int       @id @default(autoincrement())
  importacaoId      Int
  importacao        SpedFiscalImportacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  tipo              String    // CADASTRO_CNPJ | CADASTRO_IE | CADASTRO_UF | CFOP | CST_ICMS | VALOR_ICMS | BASE_CALCULO | ALIQUOTA | VALOR_NF | CHAVE_INEXISTENTE | NF_AUSENTE_SPED | IE_DIVERGENTE | NCM_DIVERGENTE | VALOR_ST | VALOR_IPI | APURACAO | DEVOLUCAO_IRREGULAR | TIPO_OPERACAO | NF_CANCELADA | NF_DENEGADA | VALOR_FRETE | VALOR_DESCONTO | DATA_EMISSAO | QUANTIDADE | VALOR_UNITARIO | PIS_COFINS | ALIQUOTA_INTER | ST_SEM_DESTAQUE | CREDITO_INDEVIDO | SIMPLES_NACIONAL
  severidade        String    // CRITICA | ALTA | MEDIA | BAIXA | INFO
  codigoRegra       String    // R-CAD-01, R-DOC-01, R-ITEM-01, etc.
  chaveNfe          String?   // chave 44 dígitos, quando aplicável
  registroSped      String?   // "C100" | "C170" | "0150" etc.
  linhaSped         Int?      // linha do arquivo onde o registro está
  campo             String?   // nome do campo divergente (ex: "vICMS", "CFOP", "IE")
  valorSped         String?   // valor que consta no SPED
  valorDanfe        String?   // valor que consta no XML/DANFE
  descricao         String    // descrição humana da divergência
  participanteCod   String?   // código do participante no 0150
  produtoCod        String?   // código do produto no 0200
  fornecedorNome    String?   // nome do fornecedor (para facilitar filtros)
  fornecedorCnpj    String?   // CNPJ do fornecedor
  resolvida         Boolean   @default(false)
  resolvidaEm       DateTime?
  resolvidaPor      String?
  observacao         String?   // nota do operador
  createdAt         DateTime  @default(now())

  @@index([importacaoId, tipo])
  @@index([importacaoId, severidade])
  @@index([importacaoId, resolvida])
  @@index([chaveNfe])
  @@index([fornecedorCnpj])
}

// Cor de cada etiqueta (preset ou personalizada) usada em NotaFiscal.etiqueta.
// NotaFiscal.etiqueta continua sendo a lista (CSV) de nomes de etiqueta; esta
// tabela só guarda a cor de exibição de cada nome, criada sob demanda quando
// o usuário cria uma etiqueta nova na tela da nota.
model EtiquetaDefinicao {
  nome     String   @id
  cor      String   // hex "#RRGGBB"
  criadoEm DateTime @default(now())
}
